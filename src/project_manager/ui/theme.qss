QWidget { background: #171717; color: #E5E5E5; font-family: '맑은 고딕', 'Segoe UI'; font-size: 13px; }
QWidget#sidebar { background: #111111; border-right: 1px solid #333333; }
QLabel { background: transparent; }
QLabel#brand { font-size: 17px; font-weight: 600; padding: 8px 0; }
QLabel#heading { font-size: 23px; font-weight: 600; }
QLabel#muted { color: #A3A3A3; }
QPushButton { background: transparent; border: 1px solid #333333; border-radius: 7px; padding: 8px 13px; }
QPushButton:hover { background: #262626; }
QPushButton:pressed { background: #333333; }
QPushButton:disabled { color: #626262; border-color: #262626; }
QPushButton#primary { background: #E5E5E5; color: #171717; border: 0; }
QPushButton#nav { border: 0; text-align: left; padding: 10px 8px; }
QPushButton#nav:checked { background: #262626; }
QLineEdit, QPlainTextEdit, QTextEdit, QComboBox { background: #1E1E1E; border: 1px solid #333333; border-radius: 6px; padding: 8px; selection-background-color: #444444; }
QComboBox { padding-right: 24px; }
QComboBox::drop-down { border: 0; width: 22px; background: transparent; }
QListWidget { background: transparent; border: 0; outline: 0; }
QListWidget::item { border-radius: 7px; padding: 11px 10px; margin: 2px 0; }
QListWidget::item:selected { background: #262626; color: #E5E5E5; }
QListWidget::item:hover { background: #202020; }
QSplitter::handle { background: #333333; width: 1px; }
QScrollBar:vertical { background: transparent; width: 8px; }
QScrollBar::handle:vertical { background: #444444; border-radius: 4px; min-height: 25px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QProgressBar { border: 1px solid #333333; border-radius: 4px; text-align: center; }
QProgressBar::chunk { background: #A3A3A3; }
QWidget:focus { outline: 0; }
QPushButton:focus, QLineEdit:focus { border: 1px solid #777777; }
QListWidget:focus { border: 0; outline: 0; }
QListWidget::item:selected:hover { background: #262626; }
QScrollBar:horizontal { background: transparent; height: 8px; }
QScrollBar::handle:horizontal { background: #444444; border-radius: 4px; min-width: 25px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QDialog { background: #171717; }
QTreeView { background: #171717; border: 0; outline: 0; show-decoration-selected: 1; }
QTreeView::item { padding: 8px 5px; border: 0; }
QTreeView::item:selected { background: #303030; color: #FAFAFA; }
QTreeView::item:hover { background: #232323; }
QTreeView::item:selected:hover { background: #303030; }
QHeaderView::section { background: #1D1D1D; color: #A3A3A3; border: 0; border-bottom: 1px solid #333333; padding: 10px 8px; text-align: left; }
QHeaderView { background: #1D1D1D; }
QTabWidget::pane { border: 0; border-top: 1px solid #333333; }
QTabBar::tab { background: transparent; color: #A3A3A3; padding: 10px 14px; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #F1F0EB; border-bottom: 2px solid #F1F0EB; }
QWidget#details { background: #1B1B1B; border-radius: 8px; }
QLabel#section { color: #828282; font-size: 11px; padding: 6px 0; }
QLabel#detailTitle { font-size: 17px; font-weight: 600; }
QLabel#empty { color: #A3A3A3; padding: 35px 20px; }
QPushButton#crumb { border: 0; color: #A3A3A3; padding: 6px 4px; }
QMenu { background: #242424; border: 1px solid #414141; padding: 6px; }
QMenu::item { padding: 9px 22px; border-radius: 4px; }
QMenu::item:selected { background: #383838; }
QMenu::item:disabled { color: #626262; }
QComboBox QAbstractItemView { background: #242424; selection-background-color: #3A3A3A; border: 1px solid #444444; }
